<Page
    x:Class="YoutubeApp.Pages.ShowResultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:YoutubeApp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:YoutubeApp.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:YoutubeApp.Models"
    xmlns:paginationControl="clr-namespace:YoutubeApp.Components.PaginationControl"
    xmlns:searchFilterControl="clr-namespace:YoutubeApp.Components.SearchFilterControl"
    Title="ShowResultPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Page.Resources>
        <!--  =================================================================  -->
        <!--  Converter 資源區  -->
        <!--  =================================================================  -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <cv:DurationConverter x:Key="DurationConverter" />
        <cv:ViewCountConverter x:Key="ViewCountConverter" />
        <cv:PublishedTimeConverter x:Key="PublishedTimeConverter" />

        <!--  =================================================================  -->
        <!--  1. 影片樣板 (對應 VideoViewModel)  -->
        <!--  =================================================================  -->
        <DataTemplate DataType="{x:Type models:YouTubeVideoViewModel}">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="360" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  影片縮圖按鈕  -->
                <Button
                    Grid.Row="0"
                    Width="400"
                    Height="225"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Cursor="Hand"
                    UseLayoutRounding="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Width="400" Height="225">
                                <Grid.Clip>
                                    <RectangleGeometry
                                        RadiusX="12"
                                        RadiusY="12"
                                        Rect="0,0,400,225" />
                                </Grid.Clip>
                                <Border>
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding VideoThumbnailUrl}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>

                                <!--  時長徽章  -->
                                <Border
                                    Margin="0,0,14,14"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="#CC000000"
                                    CornerRadius="4">
                                    <TextBlock
                                        Margin="5,2"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding Duration, Converter={StaticResource DurationConverter}}" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!--  影片資訊按鈕  -->
                <Button
                    Grid.Row="1"
                    Width="410"
                    Padding="0"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand">
                    <StackPanel Margin="0,3,10,0">
                        <!--  標題  -->
                        <TextBlock
                            MaxHeight="54"
                            Margin="0,0,0,8"
                            FontSize="19"
                            FontWeight="Medium"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />

                        <!--  觀看次數與發布時間  -->
                        <TextBlock Margin="0,0,0,10" FontSize="14">
                            <Run Text="{Binding ViewCount, Converter={StaticResource ViewCountConverter}}" />
                            <Run Text=" ‧ " />
                            <Run Text="{Binding PublishedAt, Converter={StaticResource PublishedTimeConverter}}" />
                        </TextBlock>

                        <!--  頻道按鈕  -->
                        <Button
                            Margin="-4,0,0,10"
                            Padding="4"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding GoToChannelCommand}"
                            Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,8,0">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding ChannelThumbnailUrl}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="{Binding ChannelTitle}" />
                            </StackPanel>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="bg"
                                        Background="Transparent"
                                        CornerRadius="16">
                                        <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ContentSource="Content" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#1A000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>

        <!--  =================================================================  -->
        <!--  2. 頻道樣板 (對應 ChannelsModel.Item)  -->
        <!--  =================================================================  -->
        <DataTemplate DataType="{x:Type models:ChannelModelItem}">
            <!--  附註：WPF 參照內部巢狀類別時使用加號 "+" (ChannelsModel+Item)  -->
            <Border
                Width="410"
                Margin="4"
                Padding="8"
                Background="Transparent">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <!--  頻道圓形大頭貼  -->
                    <Ellipse
                        Width="110"
                        Height="110"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding snippet.thumbnails.high.url}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>

                    <!--  頻道文字資訊  -->
                    <StackPanel Width="270" VerticalAlignment="Center">
                        <!--  頻道名稱  -->
                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Text="{Binding snippet.title}"
                            TextTrimming="CharacterEllipsis" />

                        <!--  自訂 Handle 與 訂閱者總數  -->
                        <TextBlock
                            Margin="0,4,0,4"
                            FontSize="13"
                            Foreground="Gray">
                            <Run Text="{Binding snippet.customUrl}" />
                            <Run Text=" ‧ " />
                            <Run Text="{Binding statistics.subscriberCount, Converter={StaticResource ViewCountConverter}}" />
                            <Run Text="位訂閱者" />
                        </TextBlock>

                        <!--  頻道簡介  -->
                        <TextBlock
                            MaxHeight="36"
                            FontSize="12"
                            Foreground="#606060"
                            Text="{Binding snippet.description}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  =================================================================  -->
        <!--  3. 播放清單樣板 (對應 PlayListItemsList.Item)  -->
        <!--  =================================================================  -->
        <DataTemplate DataType="{x:Type models:PlayListItem}">
            <!--  附註：WPF 參照內部巢狀類別時使用加號 "+" (PlayListItemsList+Item)  -->
            <Grid Width="410" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="225" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  播放清單封面縮圖  -->
                <Grid
                    Grid.Row="0"
                    Width="400"
                    Height="225"
                    HorizontalAlignment="Left">
                    <Grid.Clip>
                        <RectangleGeometry
                            RadiusX="12"
                            RadiusY="12"
                            Rect="0,0,400,225" />
                    </Grid.Clip>
                    <Border>
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding snippet.thumbnails.high.url}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>

                    <!--  右下角影片部數徽章  -->
                    <Border
                        Margin="0,0,14,14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="#CC000000"
                        CornerRadius="4">
                        <StackPanel Margin="6,2" Orientation="Horizontal">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding contentDetails.itemCount}" />
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text=" 部影片" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  播放清單資訊  -->
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <!--  清單標題  -->
                    <TextBlock
                        MaxHeight="50"
                        FontSize="18"
                        FontWeight="Medium"
                        Text="{Binding snippet.title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />

                    <!--  擁有者頻道名稱  -->
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="14"
                        Foreground="Gray">
                        <Run Text="{Binding snippet.channelTitle}" />
                        <Run Text=" ‧ 播放清單" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!--  =====================================================  -->
    <!--  下方主要內容  -->
    <!--  =====================================================  -->

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <!--  左側  -->
            <ColumnDefinition Width="280" />
            <!--  右側  -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <!--  =================================================  -->
        <!--  左側訂閱頻道  -->
        <!--  =================================================  -->

        <Grid Grid.Column="0" Margin="0,0,10,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>


            <!--  訂閱頻道  -->
            <Button
                Grid.Row="0"
                Margin="5"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Content="訂閱頻道"
                FontSize="18" />


            <!--  頻道列表  -->
            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <ItemsControl BorderThickness="0" ItemsSource="{Binding myFavorites}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  頻道頭像  -->
                                <Button
                                    Grid.Column="0"
                                    Width="45"
                                    Height="45"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0">
                                    <Image
                                        Width="32"
                                        Height="32"
                                        Margin="5"
                                        Source="{Binding snippet.thumbnails._default.url}"
                                        Stretch="Uniform" />
                                </Button>

                                <!--  頻道名稱  -->
                                <Button
                                    Grid.Column="1"
                                    Height="45"
                                    Padding="5,0"
                                    HorizontalContentAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Content="{Binding snippet.title}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </ScrollViewer>


            <!--  更多  -->
            <Button
                Grid.Row="2"
                Margin="5"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding moreSubscribCommand}"
                Content="更多…"
                FontSize="18"
                Visibility="{Binding IsMoreSubscrib, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>


        <!--  =================================================  -->
        <!--  右側搜尋結果  -->
        <!--  =================================================  -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <!--  篩選器  -->
                <RowDefinition Height="55" />
                <!--  搜尋結果  -->
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>


            <!--  =================================================  -->
            <!--  篩選器  -->
            <!--  =================================================  -->

            <Grid
                Grid.Row="0"
                Height="55"
                VerticalAlignment="Top"
                Visibility="{Binding IsSearchKeyWordExist, Converter={StaticResource BooleanToVisibilityConverter}}">

                <ToggleButton
                    x:Name="searchFilterButton"
                    Width="100"
                    Height="40"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand">

                    <ToggleButton.Content>
                        <StackPanel Margin="12,0" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="Medium"
                                Text="篩選器" />
                            <Path
                                Width="18"
                                Height="16"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                Stroke="Black"
                                StrokeThickness="2">
                                <Path.Data>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,3" EndPoint="3,3" />
                                        <EllipseGeometry
                                            Center="5.5,3"
                                            RadiusX="2.5"
                                            RadiusY="2.5" />
                                        <LineGeometry StartPoint="8,3" EndPoint="16,3" />
                                        <LineGeometry StartPoint="0,11" EndPoint="9,11" />
                                        <EllipseGeometry
                                            Center="11.5,11"
                                            RadiusX="2.5"
                                            RadiusY="2.5" />
                                        <LineGeometry StartPoint="14,11" EndPoint="16,11" />
                                    </GeometryGroup>
                                </Path.Data>
                            </Path>
                        </StackPanel>
                    </ToggleButton.Content>

                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                x:Name="bg"
                                Background="#EEEEEE"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="20">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ContentSource="Content" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#DDDDDD" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#CCCCCC" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>

                </ToggleButton>

                <!--  =====================================================  -->
                <!--  篩選器 Popup  -->
                <!--  =====================================================  -->

                <Popup
                    AllowsTransparency="True"
                    IsOpen="{Binding IsChecked, ElementName=searchFilterButton, Mode=TwoWay}"
                    Placement="Center"
                    PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    StaysOpen="False">
                    <searchFilterControl:SearchFilter SearchFilterCommand="{Binding searchFilterCommand}" />
                </Popup>
            </Grid>


            <!--  =================================================  -->
            <!--  搜尋影片  -->
            <!--  =================================================  -->

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Disabled">

                <ItemsControl
                    BorderThickness="0"
                    Cursor=""
                    ItemsSource="{Binding CurrentShownItems}">

                    <!--  保留原本自動折行的 WrapPanel 版面配置  -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <!-- 注意：完全不需要寫 <ItemsControl.ItemTemplate>！ -->
                    <!--  WPF 會自動去 Window.Resources 比對各物件的型別，並套用對應的樣板  -->

                </ItemsControl>
            </ScrollViewer>
            <paginationControl:Pagination
                Grid.Row="2"
                GoToPageCommand="{Binding GoToPageCommand}"
                TotalCount="{Binding TotalCount}"
                Visibility="{Binding IsResultExist, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</Page>
