<Window
    x:Class="YoutubeApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:api="clr-namespace:YoutubeAPI;assembly=YoutubeAPI"
    xmlns:cv="clr-namespace:YoutubeApp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:YoutubeApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:YoutubeApp.Models"
    xmlns:paginationControl="clr-namespace:YoutubeApp.Components.PaginationControl"
    xmlns:searchFilterControl="clr-namespace:YoutubeApp.Components.SearchFilterControl"
    Title="BouTube"
    Width="1400"
    Height="720"
    MinWidth="900"
    MinHeight="600"
    mc:Ignorable="d">

    <Window.Resources>
        <!--  =================================================================  -->
        <!--  Converter 資源區  -->
        <!--  =================================================================  -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <cv:DurationConverter x:Key="DurationConverter" />
        <cv:ViewCountConverter x:Key="ViewCountConverter" />
        <cv:PublishedTimeConverter x:Key="PublishedTimeConverter" />
    </Window.Resources>

    <!--  =========================================================  -->
    <!--  Main Window  -->
    <!--  =========================================================  -->

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!--  =====================================================  -->
        <!--  上方搜尋列  -->
        <!--  =====================================================  -->

        <Grid Grid.Row="0" Margin="10">

            <Grid.ColumnDefinitions>
                <!--  Logo  -->
                <ColumnDefinition Width="Auto" />
                <!--  Search  -->
                <ColumnDefinition Width="*" />
                <!--  Search Button  -->
                <ColumnDefinition Width="Auto" />
                <!--  Account  -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>


            <!--  Logo  -->
            <Label
                Grid.Column="0"
                Margin="5,0,15,0"
                VerticalAlignment="Center"
                Content="BouTube"
                FontSize="20" />


            <!--  搜尋框  -->
            <TextBox
                Grid.Column="1"
                Height="42"
                Margin="5,0"
                Padding="12,0"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                FontSize="18"
                Text="{Binding SearchKeyWord, UpdateSourceTrigger=PropertyChanged}" />


            <!--  搜尋按鈕  -->
            <Button
                Grid.Column="2"
                Width="80"
                Height="42"
                Margin="5,0,15,0"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding searchCommand}"
                Content="搜尋"
                FontSize="18" />


            <!--  使用者按鈕  -->
            <ToggleButton
                x:Name="AdminButton"
                Grid.Column="3"
                Width="40"
                Height="40"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand">

                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Ellipse x:Name="bg" Fill="Transparent" />
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Content" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="#1A000000" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="#33000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>

                <!--  頭像  -->
                <Ellipse Width="30" Height="30">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding myAccount.snippet.thumbnails.medium.url}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </ToggleButton>

        </Grid>


        <!--  =====================================================  -->
        <!--  使用者 Popup  -->
        <!--  =====================================================  -->

        <Popup
            AllowsTransparency="True"
            IsOpen="{Binding IsChecked, ElementName=AdminButton}"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=AdminButton}"
            PopupAnimation="Fade"
            StaysOpen="False">

            <!--  外層容器：陰影、圓角與白底  -->
            <Border
                Margin="12"
                Padding="24"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="20"
                        Direction="270"
                        Opacity="0.12"
                        ShadowDepth="4"
                        Color="Black" />
                </Border.Effect>

                <StackPanel>
                    <Button Height="35" Content="Hello" />
                </StackPanel>

            </Border>
        </Popup>
        <Frame Name="frame" Grid.Row="1"></Frame>

    </Grid>
</Window>