<Window
    x:Class="YoutubeApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:YoutubeApp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:searchFilterControl="clr-namespace:YoutubeApp.Components.SearchFilterControl"
    Title="BouTube"
    Width="1400"
    Height="720"
    MinWidth="900"
    MinHeight="600"
    mc:Ignorable="d">

    <Window.Resources>

        <!--  Converter  -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <cv:DurationConverter x:Key="DurationConverter" />
        <cv:ViewCountConverter x:Key="ViewCountConverter" />
        <cv:PublishedTimeConverter x:Key="PublishedTimeConverter" />

    </Window.Resources>


    <!--  =========================================================  -->
    <!--  Main Window  -->
    <!--  =========================================================  -->

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!--  =====================================================  -->
        <!--  上方搜尋列  -->
        <!--  =====================================================  -->

        <Grid Grid.Row="0" Margin="10">

            <Grid.ColumnDefinitions>
                <!--  Logo  -->
                <ColumnDefinition Width="Auto" />
                <!--  Search  -->
                <ColumnDefinition Width="*" />
                <!--  Search Button  -->
                <ColumnDefinition Width="Auto" />
                <!--  Account  -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>


            <!--  Logo  -->
            <Label
                Grid.Column="0"
                Margin="5,0,15,0"
                VerticalAlignment="Center"
                Content="BouTube"
                FontSize="20" />


            <!--  搜尋框  -->
            <TextBox
                Grid.Column="1"
                Height="42"
                Margin="5,0"
                Padding="12,0"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                FontSize="18"
                Text="{Binding SearchKeyWord, UpdateSourceTrigger=PropertyChanged}" />


            <!--  搜尋按鈕  -->
            <Button
                Grid.Column="2"
                Width="80"
                Height="42"
                Margin="5,0,15,0"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding searchCommand}"
                Content="搜尋"
                FontSize="18" />


            <!--  使用者按鈕  -->
            <ToggleButton
                x:Name="AdminButton"
                Grid.Column="3"
                Width="40"
                Height="40"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand">

                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Ellipse x:Name="bg" Fill="Transparent" />
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Content" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="#1A000000" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="#33000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>

                <!--  頭像  -->
                <Ellipse Width="30" Height="30">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding myAccount.snippet.thumbnails.medium.url}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </ToggleButton>

        </Grid>


        <!--  =====================================================  -->
        <!--  使用者 Popup  -->
        <!--  =====================================================  -->

        <Popup
            AllowsTransparency="True"
            IsOpen="{Binding IsChecked, ElementName=AdminButton}"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=AdminButton}"
            PopupAnimation="Fade"
            StaysOpen="False">

            <!--  外層容器：陰影、圓角與白底  -->
            <Border
                Margin="12"
                Padding="24"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="20"
                        Direction="270"
                        Opacity="0.12"
                        ShadowDepth="4"
                        Color="Black" />
                </Border.Effect>

                <StackPanel>
                    <Button Height="35" Content="Hello" />
                </StackPanel>

            </Border>
        </Popup>


        <!--  =====================================================  -->
        <!--  下方主要內容  -->
        <!--  =====================================================  -->

        <Grid Grid.Row="1" Margin="10">

            <Grid.ColumnDefinitions>
                <!--  左側  -->
                <ColumnDefinition Width="280" />
                <!--  右側  -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <!--  =================================================  -->
            <!--  左側訂閱頻道  -->
            <!--  =================================================  -->

            <Grid Grid.Column="0" Margin="0,0,10,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>


                <!--  訂閱頻道  -->
                <Button
                    Grid.Row="0"
                    Margin="5"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Content="訂閱頻道"
                    FontSize="18" />


                <!--  頻道列表  -->
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">

                    <ItemsControl BorderThickness="0" ItemsSource="{Binding myFavorites}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  頻道頭像  -->
                                    <Button
                                        Grid.Column="0"
                                        Width="45"
                                        Height="45"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0">
                                        <Image
                                            Width="32"
                                            Height="32"
                                            Margin="5"
                                            Source="{Binding snippet.thumbnails._default.url}"
                                            Stretch="Uniform" />
                                    </Button>

                                    <!--  頻道名稱  -->
                                    <Button
                                        Grid.Column="1"
                                        Height="45"
                                        Padding="5,0"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Content="{Binding snippet.title}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </ScrollViewer>


                <!--  更多  -->
                <Button
                    Grid.Row="2"
                    Margin="5"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Command="{Binding moreSubscribCommand}"
                    Content="更多…"
                    FontSize="18"
                    Visibility="{Binding IsMoreSubscrib, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>


            <!--  =================================================  -->
            <!--  右側搜尋結果  -->
            <!--  =================================================  -->

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <!--  篩選器  -->
                    <RowDefinition Height="55" />
                    <!--  搜尋結果  -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>


                <!--  =================================================  -->
                <!--  篩選器  -->
                <!--  =================================================  -->

                <Grid Grid.Row="0" Visibility="{Binding IsSearchKeyWordExist, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <ToggleButton
                        x:Name="searchFilterButton"
                        Width="100"
                        Height="40"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">

                        <ToggleButton.Content>
                            <StackPanel Margin="12,0" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="Medium"
                                    Text="篩選器" />
                                <Path
                                    Width="18"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Stretch="Uniform"
                                    Stroke="Black"
                                    StrokeThickness="2">
                                    <Path.Data>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="0,3" EndPoint="3,3" />
                                            <EllipseGeometry
                                                Center="5.5,3"
                                                RadiusX="2.5"
                                                RadiusY="2.5" />
                                            <LineGeometry StartPoint="8,3" EndPoint="16,3" />
                                            <LineGeometry StartPoint="0,11" EndPoint="9,11" />
                                            <EllipseGeometry
                                                Center="11.5,11"
                                                RadiusX="2.5"
                                                RadiusY="2.5" />
                                            <LineGeometry StartPoint="14,11" EndPoint="16,11" />
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                            </StackPanel>
                        </ToggleButton.Content>

                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border
                                    x:Name="bg"
                                    Background="#EEEEEE"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="20">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ContentSource="Content" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#DDDDDD" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#CCCCCC" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>

                    </ToggleButton>

                    <!--  =====================================================  -->
                    <!--  篩選器 Popup  -->
                    <!--  =====================================================  -->

                    <Popup
                        AllowsTransparency="True"
                        IsOpen="{Binding IsChecked, ElementName=searchFilterButton, Mode=TwoWay}"
                        Placement="Center"
                        PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        StaysOpen="False">
                        <searchFilterControl:SearchFilter Command="{Binding searchFilterCommand}"></searchFilterControl:SearchFilter>
                    </Popup>
                </Grid>


                <!--  =================================================  -->
                <!--  搜尋影片  -->
                <!--  =================================================  -->

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">

                    <ItemsControl
                        BorderThickness="0"
                        Cursor=""
                        ItemsSource="{Binding videoInfoItems}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!--  使用 WrapPanel，不寫死 Columns，讓子元素自動流動換行  -->
                                <WrapPanel IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4" Cursor="">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="180" />
                                        <!--  上：缩图，固定高度对应你的 Button 高度  -->
                                        <RowDefinition Height="Auto" />
                                        <!--  下：说明文字，依内容自动伸展  -->
                                    </Grid.RowDefinitions>


                                    <!--  =================================================  -->
                                    <!--  影片縮圖  -->
                                    <!--  =================================================  -->

                                    <Button
                                        Grid.Row="0"
                                        Width="320"
                                        Height="180"
                                        Margin="0,0,0,0"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Cursor="Hand"
                                        UseLayoutRounding="True">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Width="320" Height="180">
                                                    <!--  整个 Grid 自己套一层圆角 Clip,而不是靠 Border 的自动裁切  -->
                                                    <Grid.Clip>
                                                        <RectangleGeometry
                                                            RadiusX="12"
                                                            RadiusY="12"
                                                            Rect="0,0,320,180" />
                                                    </Grid.Clip>
                                                    <!--  只让图片被圆角裁切,徽章不在这层里面  -->
                                                    <Border>
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding VideoThumbnailUrl}" Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>

                                                    <!--  徽章放在 Grid 直接子层,Margin 拉大到 >= 圆角半径,避开弧线区域  -->
                                                    <Border
                                                        Margin="0,0,14,14"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Background="#CC000000"
                                                        CornerRadius="4">
                                                        <TextBlock
                                                            Margin="5,2"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="White"
                                                            Text="{Binding Duration, Converter={StaticResource DurationConverter}}" />
                                                    </Border>
                                                </Grid>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>


                                    <!--  =================================================  -->
                                    <!--  影片資訊  -->
                                    <!--  =================================================  -->

                                    <Button
                                        Grid.Row="1"
                                        Width="330"
                                        Padding="0"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Top"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">

                                        <StackPanel Margin="0,3,10,0" Cursor="">

                                            <!--  標題  -->
                                            <TextBlock
                                                MaxHeight="54"
                                                Margin="0,0,0,8"
                                                FontSize="19"
                                                FontWeight="Medium"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />

                                            <!--  觀看次數  -->
                                            <TextBlock Margin="0,0,0,10" FontSize="14">
                                                <Run Text="{Binding ViewCount, Converter={StaticResource ViewCountConverter}}" />
                                                <Run Text=" ‧ " />
                                                <Run Text="{Binding PublishedAt, Converter={StaticResource PublishedTimeConverter}}" />
                                            </TextBlock>


                                            <!--  =================================================  -->
                                            <!--  頻道按鈕 (獨立點擊範圍)  -->
                                            <!--  =================================================  -->
                                            <Button
                                                Margin="-4,0,0,10"
                                                Padding="4"
                                                HorizontalAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding GoToChannelCommand}"
                                                Cursor="Hand">

                                                <!--  這裡綁定你未來用來切換頻道的 Command  -->
                                                <StackPanel Orientation="Horizontal">

                                                    <!--  頻道大頭照  -->
                                                    <Ellipse
                                                        Width="24"
                                                        Height="24"
                                                        Margin="0,0,8,0">
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding ChannelThumbnailUrl}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>

                                                    <!--  頻道名稱  -->
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        Text="{Binding ChannelTitle}" />

                                                </StackPanel>

                                                <!--  覆寫按鈕樣式，讓它看起來不像傳統按鈕，但在滑鼠懸停時給予微小回饋  -->
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border
                                                            x:Name="bg"
                                                            Background="Transparent"
                                                            CornerRadius="16">
                                                            <ContentPresenter
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                ContentSource="Content" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <!--  滑鼠移過去時，顯示極淺的灰色底，提示使用者這裡可以點  -->
                                                                <Setter TargetName="bg" Property="Background" Value="#1A000000" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Button>

                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </ScrollViewer>

            </Grid>
        </Grid>
    </Grid>
</Window>