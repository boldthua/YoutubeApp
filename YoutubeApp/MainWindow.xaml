<Window
    x:Class="YoutubeApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:cv="clr-namespace:YoutubeApp.Converters"
    Title="BouTube"
    Width="1280"
    Height="720"
    MinWidth="900"
    MinHeight="600"
    Background="#0F0F0F"
    mc:Ignorable="d">

    <Window.Resources>

        <!-- Converter -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <cv:DurationConverter x:Key="DurationConverter" />
        <cv:ViewCountConverter x:Key="ViewCountConverter" />
        <cv:PublishedTimeConverter x:Key="PublishedTimeConverter" />

    </Window.Resources>


    <!-- ========================================================= -->
    <!-- Main Window -->
    <!-- ========================================================= -->

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- 上方搜尋列 -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="0"
            Margin="10">

            <Grid.ColumnDefinitions>
                <!-- Logo -->
                <ColumnDefinition Width="Auto" />
                <!-- Search -->
                <ColumnDefinition Width="*" />
                <!-- Search Button -->
                <ColumnDefinition Width="Auto" />
                <!-- Account -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>


            <!-- Logo -->
            <Label
                Grid.Column="0"
                Margin="5,0,15,0"
                VerticalAlignment="Center"
                FontSize="20"
                Foreground="White"
                Content="BouTube" />


            <!-- 搜尋框 -->
            <TextBox
                Grid.Column="1"
                Height="42"
                Margin="5,0"
                VerticalAlignment="Center"
                Padding="12,0"
                FontSize="18"
                Foreground="White"
                Background="#202020"
                BorderBrush="#444444"
                Text="{Binding searchKeyword, UpdateSourceTrigger=PropertyChanged}" />


            <!-- 搜尋按鈕 -->
            <Button
                Grid.Column="2"
                Width="80"
                Height="42"
                Margin="5,0,15,0"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding searchCommand}"
                FontSize="18"
                Content="搜尋" />


            <!-- 使用者按鈕 -->
            <ToggleButton
                x:Name="AdminButton"
                Grid.Column="3"
                Width="40"
                Height="40"
                VerticalAlignment="Center"
                Cursor="Hand"
                Background="Transparent"
                BorderThickness="0">

                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Ellipse
                                x:Name="bg"
                                Fill="Transparent" />
                            <ContentPresenter
                                ContentSource="Content"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>

                <!-- 頭像 -->
                <Ellipse
                    Width="30"
                    Height="30">
                    <Ellipse.Fill>
                        <ImageBrush
                            ImageSource="{Binding myAccount.snippet.thumbnails.medium.url}"
                            Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </ToggleButton>

        </Grid>


        <!-- ===================================================== -->
        <!-- 使用者 Popup -->
        <!-- ===================================================== -->

        <Popup
            IsOpen="{Binding IsChecked, ElementName=AdminButton}"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=AdminButton}"
            StaysOpen="False"
            AllowsTransparency="True">

            <Border
                MinWidth="180"
                Padding="10"
                Background="#252525"
                CornerRadius="8"
                BorderBrush="#444444"
                BorderThickness="1">

                <StackPanel>
                    <Button
                        Height="35"
                        Content="Hello" />
                </StackPanel>

            </Border>
        </Popup>


        <!-- ===================================================== -->
        <!-- 下方主要內容 -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="1"
            Margin="10">

            <Grid.ColumnDefinitions>
                <!-- 左側 -->
                <ColumnDefinition Width="280" />
                <!-- 右側 -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- 左側訂閱頻道 -->
            <!-- ================================================= -->

            <Grid
                Grid.Column="0"
                Margin="0,0,10,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>


                <!-- 訂閱頻道 -->
                <Button
                    Grid.Row="0"
                    Margin="5"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="18"
                    Content="訂閱頻道" />


                <!-- 頻道列表 -->
                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl
                        BorderThickness="0"
                        ItemsSource="{Binding myFavorites}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 頻道頭像 -->
                                    <Button
                                        Grid.Column="0"
                                        Width="45"
                                        Height="45"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0">
                                        <Image
                                            Width="32"
                                            Height="32"
                                            Margin="5"
                                            Source="{Binding snippet.thumbnails._default.url}"
                                            Stretch="Uniform" />
                                    </Button>

                                    <!-- 頻道名稱 -->
                                    <Button
                                        Grid.Column="1"
                                        Height="45"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        Padding="5,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Content="{Binding snippet.title}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </ScrollViewer>


                <!-- 更多 -->
                <Button
                    Grid.Row="2"
                    Margin="5"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Command="{Binding moreSubscribCommand}"
                    FontSize="18"
                    Visibility="{Binding IsMoreSubscrib, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Content="更多…" />
            </Grid>


            <!-- ================================================= -->
            <!-- 右側搜尋結果 -->
            <!-- ================================================= -->

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <!-- 篩選器 -->
                    <RowDefinition Height="55" />
                    <!-- 搜尋結果 -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- 篩選器 -->
                <!-- ================================================= -->

                <Grid Grid.Row="0">

                    <ToggleButton
                        x:Name="searchFilterButton"
                        Width="100"
                        Height="40"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0">

                        <ToggleButton.Content>
                            <StackPanel
                                Orientation="Horizontal"
                                Margin="12,0">
                                <TextBlock
                                    Text="篩選器"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="Medium"
                                    Margin="0,0,8,0" />
                                <Path
                                    Stroke="White"
                                    StrokeThickness="2"
                                    VerticalAlignment="Center"
                                    Width="18"
                                    Height="16"
                                    Stretch="Uniform">
                                    <Path.Data>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="0,3" EndPoint="3,3" />
                                            <EllipseGeometry Center="5.5,3" RadiusX="2.5" RadiusY="2.5" />
                                            <LineGeometry StartPoint="8,3" EndPoint="16,3" />
                                            <LineGeometry StartPoint="0,11" EndPoint="9,11" />
                                            <EllipseGeometry Center="11.5,11" RadiusX="2.5" RadiusY="2.5" />
                                            <LineGeometry StartPoint="14,11" EndPoint="16,11" />
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                            </StackPanel>
                        </ToggleButton.Content>

                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border
                                    x:Name="bg"
                                    Background="#3F3F3F"
                                    CornerRadius="20"
                                    BorderBrush="Transparent"
                                    BorderThickness="0">
                                    <ContentPresenter
                                        ContentSource="Content"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#555555" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#777777" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>

                    </ToggleButton>
                </Grid>


                <!-- ================================================= -->
                <!-- 搜尋影片 -->
                <!-- ================================================= -->

                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl
                        BorderThickness="0"
                        ItemsSource="{Binding searchItems}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,20">

                                    <Grid.ColumnDefinitions>
                                        <!-- 縮圖 -->
                                        <ColumnDefinition Width="320" />
                                        <!-- 文字 -->
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>


                                    <!-- ================================================= -->
                                    <!-- 影片縮圖 -->
                                    <!-- ================================================= -->

                                    <Button
                                        Grid.Column="0"
                                        Width="320"
                                        Height="180"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="0,0,15,0">

                                        <Grid
                                            Width="320"
                                            Height="180">

                                            <!-- 圖片 -->
                                            <Border CornerRadius="12">
                                                <Border.Background>
                                                    <ImageBrush
                                                        ImageSource="{Binding snippet.thumbnails.medium.url}"
                                                        Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>

                                            <!-- 影片時間 -->
                                            <Border
                                                Background="#CC000000"
                                                CornerRadius="4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="8">
                                                <TextBlock
                                                    Text="{Binding contentDetails.duration, Converter={StaticResource DurationConverter}}"
                                                    Foreground="White"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Margin="5,2" />
                                            </Border>
                                        </Grid>
                                    </Button>


                                    <!-- ================================================= -->
                                    <!-- 影片資訊 -->
                                    <!-- ================================================= -->

                                    <Button
                                        Grid.Column="1"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Top"
                                        Padding="0">

                                        <StackPanel Margin="0,3,10,0">

                                            <!-- 標題 -->
                                            <TextBlock
                                                Text="{Binding snippet.title}"
                                                FontSize="19"
                                                FontWeight="Medium"
                                                Foreground="White"
                                                TextWrapping="Wrap"
                                                TextTrimming="CharacterEllipsis"
                                                MaxHeight="54"
                                                Margin="0,0,0,8" />

                                            <!-- 觀看次數 -->
                                            <TextBlock
                                                Foreground="#AAAAAA"
                                                FontSize="14"
                                                Margin="0,0,0,10">
                                                <Run Text="{Binding statistics.viewCount, Converter={StaticResource ViewCountConverter}}" />
                                                <Run Text=" ‧ " />
                                                <Run Text="{Binding snippet.publishedAt, Converter={StaticResource PublishedTimeConverter}}" />
                                            </TextBlock>

                                            <!-- 頻道 -->
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Margin="0,0,0,10">
                                                <Ellipse
                                                    Width="24"
                                                    Height="24"
                                                    Fill="#333333"
                                                    Margin="0,0,8,0" />
                                                <TextBlock
                                                    Text="{Binding snippet.channelTitle}"
                                                    Foreground="#AAAAAA"
                                                    FontSize="14"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- 說明 -->
                                            <TextBlock
                                                Text="{Binding snippet.description}"
                                                Foreground="#AAAAAA"
                                                FontSize="13"
                                                TextWrapping="Wrap"
                                                TextTrimming="CharacterEllipsis"
                                                MaxHeight="40" />
                                        </StackPanel>
                                    </Button>

                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </ScrollViewer>

            </Grid>
        </Grid>
    </Grid>
</Window>