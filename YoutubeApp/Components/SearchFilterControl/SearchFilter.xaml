<UserControl
    x:Class="YoutubeApp.Components.SearchFilterControl.SearchFilter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:YoutubeApp.Components.SearchFilterControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border
        x:Name="searchFilterComponent"
        Margin="12"
        Padding="24"
        Background="White"
        BorderBrush="#E0E0E0"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="20"
                Direction="270"
                Opacity="0.12"
                ShadowDepth="4"
                Color="Black" />
        </Border.Effect>

        <Grid Width="600">
            <Grid.Resources>
                <!--  篩選選項按鈕樣式  -->
                <Style x:Key="FilterItemButtonStyle" TargetType="RadioButton">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#606060" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Margin" Value="0,6,0,6" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="GroupName" Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=StackPanel}}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <TextBlock
                                    x:Name="textBlock"
                                    Background="Transparent"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{TemplateBinding Content}" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="textBlock" Property="Foreground" Value="#0F0F0F" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="textBlock" Property="Foreground" Value="#0F0F0F" />
                                        <Setter TargetName="textBlock" Property="FontWeight" Value="Bold" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!--  欄位標題樣式  -->
                <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="#0F0F0F" />
                    <Setter Property="Margin" Value="0,0,0,12" />
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!--  1. 頂部標題與關閉按鈕  -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#0F0F0F"
                    Text="搜尋篩選器" />

                <!--  關閉按鈕：點擊自動關閉 Popup  -->
                <Button
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="✕"
                    Cursor="Hand"
                    FontSize="16"
                    Name="searchFilterButton"
                    Foreground="#0F0F0F">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="16">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#E5E5E5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <!--  按下關閉時取消 searchFilterButton 的 IsChecked 狀態  -->
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <BooleanAnimationUsingKeyFrames Storyboard.TargetName="searchFilterButton" Storyboard.TargetProperty="IsChecked">
                                        <DiscreteBooleanKeyFrame KeyTime="0" Value="False" />
                                    </BooleanAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <!--  2. 4 欄式篩選選單內容  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!--  第一欄：類型  -->
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    Orientation="Vertical">
                    <TextBlock Style="{StaticResource ColumnHeaderStyle}" Text="類型" />
                    <Border
                        Height="1"
                        Margin="0,0,0,12"
                        Background="#E0E0E0" />
                </StackPanel>
                <ItemsControl
                    Grid.Row="1"
                    Grid.Column="0"
                    ItemsSource="{Binding searchFilter.Type}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel
                                Grid.Column="1"
                                Margin="0,0,16,0"
                                Tag="TypeGroup">
                                <RadioButton
                                    Content="{Binding Text}"
                                    GroupName="TypeGroup"
                                    IsChecked="{Binding IsChecked}"
                                    IsEnabled="{Binding IsEnabled}"
                                    Style="{StaticResource FilterItemButtonStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  第二欄：片長  -->
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Orientation="Vertical">
                    <TextBlock Style="{StaticResource ColumnHeaderStyle}" Text="片長" />
                    <Border
                        Height="1"
                        Margin="0,0,0,12"
                        Background="#E0E0E0" />
                </StackPanel>
                <ItemsControl
                    Grid.Row="1"
                    Grid.Column="1"
                    ItemsSource="{Binding searchFilter.Duration}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel
                                Grid.Column="1"
                                Margin="0,0,16,0"
                                Tag="TypeGroup">
                                <RadioButton
                                    Content="{Binding Text}"
                                    GroupName="DurationGroup"
                                    IsChecked="{Binding IsChecked}"
                                    IsEnabled="{Binding IsEnabled}"
                                    Style="{StaticResource FilterItemButtonStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  第三欄：上傳日期  -->
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="2"
                    Orientation="Vertical">
                    <TextBlock Style="{StaticResource ColumnHeaderStyle}" Text="上傳日期" />
                    <Border
                        Height="1"
                        Margin="0,0,0,12"
                        Background="#E0E0E0" />
                </StackPanel>
                <ItemsControl
                    Grid.Row="1"
                    Grid.Column="2"
                    ItemsSource="{Binding searchFilter.UpLoadPeriod}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel
                                Grid.Column="1"
                                Margin="0,0,16,0"
                                Tag="TypeGroup">
                                <RadioButton
                                    Content="{Binding Text}"
                                    GroupName="PeriodGroup"
                                    IsChecked="{Binding IsChecked}"
                                    IsEnabled="{Binding IsEnabled}"
                                    Style="{StaticResource FilterItemButtonStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  第四欄：優先順序  -->
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="3"
                    Orientation="Vertical">
                    <TextBlock Style="{StaticResource ColumnHeaderStyle}" Text="優先順序" />
                    <Border
                        Height="1"
                        Margin="0,0,0,12"
                        Background="#E0E0E0" />
                </StackPanel>
                <ItemsControl
                    Grid.Row="1"
                    Grid.Column="3"
                    ItemsSource="{Binding searchFilter.Order}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel
                                Grid.Column="1"
                                Margin="0,0,16,0"
                                Tag="TypeGroup">
                                <RadioButton
                                    Content="{Binding Text}"
                                    GroupName="OrderGroup"
                                    IsChecked="{Binding IsChecked}"
                                    Style="{StaticResource FilterItemButtonStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <Grid Grid.Row="2" Margin="0,0,0,0">
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="100"
                        Height="32"
                        Margin="0,0,10,0"
                        Background="DodgerBlue"
                        Command="{Binding cleanFilterAndSearchCommand}"
                        Content="清除篩選條件"
                        Cursor="Hand"
                        FontSize="14"
                        Foreground="White">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="16">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <!--  Hover 時顏色微變  -->
                                                    <Setter TargetName="border" Property="Background" Value="Gray" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button
                        Width="80"
                        Height="32"
                        Background="DarkRed"
                        Command="{Binding FilterCommand}"
                        Content="開始篩選"
                        Cursor="Hand"
                        FontSize="14"
                        Foreground="White">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="16">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <!--  Hover 時顏色微變  -->
                                                    <Setter TargetName="border" Property="Background" Value="Gray" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

    </Border>

</UserControl>
