<UserControl
    x:Class="YoutubeApp.Components.PaginationControl.Pagination"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:YoutubeApp.Components.PaginationControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Border x:Name="paginationComponent">
        <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
            >

            <Button
                        Height="30"
                        Width="70"
                        Margin="3"
                        Padding="5,0"
                        Command="{Binding Go10PageFowardCommand}"
                        Content="前 10 頁"
                        Visibility="{Binding Is10PagesFoward, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <ItemsControl ItemsSource="{Binding PageSet}">
                <!--  讓頁碼水平排列  -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                                    Height="30"
                                    MinWidth="35"
                                    Margin="3"
                                    Padding="5,0"
                                    BorderThickness="{Binding Thickness}"
                                    Command="{Binding DataContext.GoToNumberPageCommand, ElementName=paginationComponent}"
                                    CommandParameter="{Binding Text}"
                                    Content="{Binding Text}" />

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button
                        Height="30"
                        Width="70"
                        Margin="3"
                        Padding="5,0"
                        Command="{Binding Go10PageBackwardCommand}"
                        Content="後 10 頁"
                        Visibility="{Binding Is10PagesBackward, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock
                        Margin="8,0,2,0"
                        VerticalAlignment="Center"
                        Text="第" />
            <TextBox
                        Width="45"
                        Height="30"
                        Margin="2,3"
                        Padding="2,1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        PreviewTextInput="PageTextBox_PreviewTextInput"
                        Text="{Binding PageText}" />
            <TextBlock
                        Margin="2,0,8,0"
                        VerticalAlignment="Center"
                        Text="頁" />
            <Button
                        Height="30"
                        Width="70"
                        Margin="3"
                        Padding="5,0"
                        Command="{Binding GoToTargetPageCommand}"
                        Content="前往" />
            <TextBlock Margin="2,0,8,0" VerticalAlignment="Center">
                        <Run Text="{Binding CurrentPage}" />
                        <Run Text=" / " />
                        <Run Text="{Binding TotalPages}" />
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
